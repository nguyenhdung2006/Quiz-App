# Safe placeholders only. Do not place real production secrets in this file.
SPRING_PROFILES_ACTIVE=prod

DATABASE_URL=jdbc:postgresql://your-production-host:5432/your_database
DATABASE_USERNAME=your_database_user
DATABASE_PASSWORD=replace-with-render-or-supabase-secret

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-secret

FRONTEND_URL=https://your-frontend.example
CORS_ALLOWED_ORIGINS=https://your-frontend.example
OAUTH_SUCCESS_REDIRECT_URI=https://your-frontend.example/index.html

SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_PATH=/

JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SECURITY=INFO

RATE_LIMIT_MODE=in-memory
AI_EXPLAIN_RATE_LIMIT_PER_MINUTE=10
AI_EXPLAIN_RATE_LIMIT_PER_DAY=100
AI_DECK_RATE_LIMIT_PER_MINUTE=3
AI_DECK_RATE_LIMIT_PER_DAY=20
AI_RATE_LIMIT_MINUTE_WINDOW=60s

OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
